+/// laneAN measurement knobs (see `pair_funclets_by_bytes`). Read once per process.
+/// 0 = stock (base side must be funclet-shaped), 1 = lifted, 2 = lifted + reloc-strict.
+#[cfg(feature = "std")]
+fn funclet_gate_mode() -> u8 {
+    static MODE: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    *MODE.get_or_init(|| match std::env::var("OBJDIFF_FUNCLET_GATE").as_deref() {
+        Ok("lifted") => 1,
+        Ok("lifted-strict") => 2,
+        _ => 0,
+    })
+}
+#[cfg(not(feature = "std"))]
+fn funclet_gate_mode() -> u8 { 0 }
+
+#[cfg(feature = "std")]
+fn funclet_gate_min() -> u64 {
+    static MIN: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *MIN.get_or_init(|| {
+        std::env::var("OBJDIFF_FUNCLET_GATE_MIN").ok().and_then(|v| v.parse().ok()).unwrap_or(0)
+    })
+}
+#[cfg(not(feature = "std"))]
+fn funclet_gate_min() -> u64 { 0 }
+
+#[cfg(feature = "std")]

+    static DBG: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *DBG.get_or_init(|| std::env::var("OBJDIFF_FUNCLET_GATE_DEBUG").is_ok_and(|v| v == "1"))
+}
+#[cfg(not(feature = "std"))]
+fn funclet_gate_debug() -> bool { false }
+
+#[cfg(feature = "std")]
+fn emit_pair_debug(pass: &str, left: &Object, right: &Object, l: usize, r: usize, lifted: bool) {
+    if !funclet_gate_debug() {
+        return;
+    }
+    let ls = &left.symbols[l];
+    let rs = &right.symbols[r];
+    let sim = match (funclet_signature(left, l), funclet_signature(right, r)) {
+        (Some(a), Some(b)) if a.len() == b.len() && !a.is_empty() => {
+            a.iter().zip(b.iter()).filter(|(x, y)| x == y).count() * 100 / a.len()
+        }
+        _ => 0,
+    };
+    let reloc_eq = match (named_symbol_signature(left, l), named_symbol_signature(right, r)) {
+        (Some(a), Some(b)) => (a.relocs == b.relocs) as u8,
+        _ => 2,
+    };
+    println!(
+        "FGPAIR\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}",
+        pass,
+        left.path.as_ref().map(|p| p.to_string_lossy().to_string()).unwrap_or_default(),
+        ls.name,
+        ls.size,
+        rs.name,
+        rs.size,
+        lifted as u8,
+        sim,
+        reloc_eq
+    );
+}
